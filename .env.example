# Required: Receiz production rails. Receiz proof objects are the system of record.
NEXT_PUBLIC_RECEIZ_MODE=live
RECEIZ_BASE_URL=https://receiz.com
RECEIZ_CLIENT_ID=
RECEIZ_CLIENT_SECRET=
# Required for OAuth state and cross-host completion tickets. Use an independent random value of at least 32 bytes.
RECEIZ_OAUTH_STATE_SECRET=

# Required: Receiz ID / OIDC callback. The Receiz client must allow the app-state,
# public-store, wallet, payment, and v104 proof-store Record/Seal/Verify scopes
# requested by the Wildz live session: receiz:record, receiz:seal, receiz:verify.
NEXT_PUBLIC_AUTH_MODE=receiz_id
RECEIZ_AUTH_MODE=receiz_id
RECEIZ_ID_CALLBACK_URL=https://wildz.quest/api/auth/receiz/callback
NEXT_PUBLIC_SITE_URL=https://wildz.quest
# Bump for each production worker release so installed PWAs receive an explicit update.
NEXT_PUBLIC_WILDZ_SW_RELEASE=v3.0.0-r104.1

# Required when a production scheduler calls POST /api/wilds/world/tick.
# Use an independent random value of at least 32 bytes. The scheduler sends it as a Bearer token.
WILDS_PULSE_TICK_SECRET=
# The scheduled pulse has no player cookie, so use a dedicated scoped server token for Receiz publication.
RECEIZ_CONNECT_ACCESS_TOKEN=

# Strict-live configuration and production activation sentinels. These do not create
# checkout capability by themselves. The user access token is generated by OIDC login.
NEXT_PUBLIC_CHECKOUT_MODE=receiz
RECEIZ_CHECKOUT_MODE=receiz

# Do not set this for normal login. It is required only for the read-only strict-live release doctor,
# using a separately provisioned scoped release credential. Do not reuse the world-pulse token.
# Normal OIDC login generates per-user access tokens at callback time.
# RECEIZ_ACCESS_TOKEN=
