+});
+export const RECEIZ_V128_NATIVE_TRADE_MCP_TOOLS = RECEIZ_V128_NATIVE_TRADE_MCP_TOOL_NAMES.map(name => ({
+    name, description: name.endsWith("trade_commit") ? "Commit one complete native trade after both device signatures and exact confirmation. Native SDK independently verifies sources, current keys, all members and root-attested complete custody. Unknown acknowledgement retains the same attempt. MCP is not authority. Output is metadata, never proof authority." : "Read native v128 wallet/trade metadata through the canonical SDK. Originals and secret authority stay process-local. MCP is not authority. Output is metadata, never proof authority.",
+    inputSchema: { type: "object", additionalProperties: false, properties: { input: { type: "object", description: "Exact canonical input. Use authorityDigest for process-held proof authority; never pass credentials or device signing keys." }, confirmation: { type: "string", description: "Exact digest from the mutation preview." } }, required: name.endsWith("capabilities") ? [] : ["input"] },
