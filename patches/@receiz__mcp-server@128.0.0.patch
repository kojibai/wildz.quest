+/** Reuses only authority admitted by the existing exact-confirmation exchange
+ * in this client process. A model-visible digest cannot create a grant. */
+export function resolveReceizMcpProofAuthorityV123(client, digest) {
+    const authority = typeof digest === "string" ? authorityCache.get(client)?.get(digest) : undefined;
+    if (!authority)
+        throw new TypeError("V123_MCP_AUTHORITY_REQUIRED");
+    return authority;
+}
