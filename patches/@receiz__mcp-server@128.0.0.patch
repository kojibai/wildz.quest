+        continue;
+    out[k] = metadata(child);
+} return out; }
+export async function callReceizV128NativeTradeMcpOperation(client, name, args) {
+    if (!RECEIZ_V128_NATIVE_TRADE_MCP_TOOL_NAMES.includes(name))
