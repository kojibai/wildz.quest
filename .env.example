# Receiz production rails. Receiz proof objects are the system of record.
NEXT_PUBLIC_RECEIZ_MODE=live
# Optional override; defaults to https://receiz.com.
RECEIZ_BASE_URL=https://receiz.com
# Legacy OAuth compatibility only. Normal Wildz login does not redirect or use these values.
RECEIZ_CLIENT_ID=
RECEIZ_CLIENT_SECRET=
# Required for encrypted, purpose-separated Wildz proof sessions and pending Vault admission.
# Use an independent random value of at least 32 bytes.
RECEIZ_OAUTH_STATE_SECRET=

# Legacy OAuth compatibility configuration. SDK-native Identity Seal login and
# exact Vault recovery are same-origin and do not use this callback.
# Legacy OAuth Record/Seal/Verify scopes: receiz:record, receiz:seal, receiz:verify.
NEXT_PUBLIC_AUTH_MODE=receiz_id
RECEIZ_AUTH_MODE=receiz_id
RECEIZ_ID_CALLBACK_URL=https://wildz.quest/api/auth/receiz/callback
NEXT_PUBLIC_SITE_URL=https://wildz.quest
# Bump for each production worker release so installed PWAs receive an explicit update.
NEXT_PUBLIC_WILDZ_SW_RELEASE=v3.0.0-r113.1

# Required when a production scheduler calls POST /api/wilds/world/tick.
# Use an independent random value of at least 32 bytes. The scheduler sends it as a Bearer token.
WILDS_PULSE_TICK_SECRET=
# Required for the durable shared world and other server-side Receiz publications.
# Provision a server-only Receiz Connect app/service credential. This is not a
# player login token and must never contain a token generated by a player session.
RECEIZ_CONNECT_ACCESS_TOKEN=

# Strict-live configuration and production activation sentinels. These do not create
# checkout capability or player authentication by themselves.
NEXT_PUBLIC_CHECKOUT_MODE=receiz
RECEIZ_CHECKOUT_MODE=receiz

# Do not set this for normal login or application runtime. It is used only by
# operator tooling such as the strict-live release doctor, with a separately
# provisioned scoped release credential. Do not reuse the Connect or pulse token.
# RECEIZ_ACCESS_TOKEN=
