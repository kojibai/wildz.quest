{
  "name": "wildz-quest",
  "version": "7.0.0",
  "description": "Open-source living game world and end-to-end Receiz SDK, MCP, and AI-skills reference implementation.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://wildz.quest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kojibai/wildz.quest.git"
  },
  "bugs": {
    "url": "https://github.com/kojibai/wildz.quest/issues"
  },
  "keywords": [
    "wildz",
    "pwa",
    "game",
    "receiz",
    "nextjs",
    "proof-objects",
    "proof-native",
    "receiz-sdk",
    "ai-skills",
    "reference-implementation",
    "portable-cards",
    "offline-first",
    "mcp",
    "model-context-protocol"
  ],
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/next-runtime-guard.mjs dev",
    "build": "node scripts/next-runtime-guard.mjs build",
    "start": "node scripts/next-runtime-guard.mjs start",
    "test": "node scripts/clean-test-build.mjs && tsc -p tsconfig.test.json && node scripts/patch-test-imports.mjs && node --test .test-build/tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "receiz:doctor": "node scripts/receiz-doctor.mjs",
    "receiz:doctor:strict": "node scripts/receiz-doctor.mjs --strict-live",
    "receiz:architecture-lock": "node scripts/receiz-architecture-lock.mjs",
    "receiz:check": "node scripts/receiz-v120-check.mjs",
    "receiz:conformance": "receiz conformance",
    "receiz:webhooks:create": "node scripts/receiz-create-webhooks.mjs",
    "secret:scan": "node scripts/release-secret-scan.mjs",
    "release:check": "node scripts/release-check.mjs",
    "social:build": "node scripts/build-social-preview.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@receiz/sdk": "120.0.0",
    "jszip": "^3.10.1",
    "kokoro-js": "1.2.1",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@receiz/ai-skills": "120.0.0",
    "@receiz/mcp-server": "120.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.10"
    }
  }
}
